  backupCapture = system "Paired application recovery capture" {
    #current
    description "CURRENT: Capture files, database and required configuration as one consistent recovery generation. An application-aware capture pairs data with database and protected configuration, then records completion and integrity metadata. An incomplete run is not a recovery point."
    link https://github.com/perkforge/perkforge-portal/blob/531f16048f4b9b574fbb389e59b7ad864b337287/docs/backup-restore.md "Source / evidence limits"
    metadata {
      status "current"
      owner "Platform Engineering · reviewed in source; owner content review pending"
      review "2026-11-15 · GitLab onboarding live milestone; other observations retain earlier evidence"
    }
    style { color green }
  }
  backupCopy = system "Independent copy and integrity" {
    #current
    description "CURRENT: Keep a verified recovery copy separate from its source. A completed secondary copy has matching destination hashes. Copy integrity is verified separately from application recovery; a second local disk is not automatically off-site or another failure domain."
    link https://github.com/perkforge/perkforge-platform/issues/81 "Source / evidence limits"
    metadata {
      status "current"
      owner "Platform Engineering · reviewed in source; owner content review pending"
      review "2026-11-15 · GitLab onboarding live milestone; other observations retain earlier evidence"
    }
    style { color green }
  }
  isolatedRestore = system "Isolated files and database restore" {
    #current
    description "CURRENT: Restore without overwriting production or the only surviving recovery set. Use compatible application/database tooling, a new volume or writable working copy and a disposable database. Inspect source media read-only and prevent unintended journal replay."
    link https://github.com/perkforge/perkforge-platform/issues/81 "Source / evidence limits"
    metadata {
      status "current"
      owner "Platform Engineering · reviewed in source; owner content review pending"
      review "2026-11-15 · GitLab onboarding live milestone; other observations retain earlier evidence"
    }
    style { color green }
  }
  restoreProof = system "Application recovery verification" {
    #current
    description "CURRENT: Prove usable recovered data rather than just successful copying or database startup. The accepted bounded primary-set drill passed app/database startup and active-file size/hash checks. Secondary-copy hash verification is separate and does not prove that copied set boots."
    link https://github.com/perkforge/perkforge-platform/issues/81 "Source / evidence limits"
    metadata {
      status "current"
      owner "Platform Engineering · reviewed in source; owner content review pending"
      review "2026-11-15 · GitLab onboarding live milestone; other observations retain earlier evidence"
    }
    style { color green }
  }
  reviewedCutover = system "Explicitly reviewed production cutover" {
    #unverified
    description "UNVERIFIED: Make a recovery result the production source only after a separate decision. Review recovery point and newer-data loss, downtime, desired-state ownership, storage/database references and identity before any replacement. This model performs no restore or cutover."
