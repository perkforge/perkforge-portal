  platform.keycloak -> platform.headlamp "UNVERIFIED: identity claims; RBAC decides access" { #unverified }
  platform.headlamp -> tenant.workload "UNVERIFIED: user-scoped Kubernetes API requests" { #unverified }
  platform.flux -> tenant.workload "UNVERIFIED: reconciles reviewed application desired state" { #unverified }
  tenant.workload -> tenant.data "UNVERIFIED: application data access within reviewed policy" { #unverified }
  portal -> platform.keycloak "CURRENT: OIDC code + PKCE; server validates signed access token" { #current }
  external -> gitlab "PLANNED: allowlisted digest intake + per-platform scan" { #planned }
  gitlab -> harbor "PLANNED: protected publish after verified gate evidence" { #planned }
  harbor -> tenant.workload "PLANNED: approved digest image pull; runtime fetches bytes" { #planned }
  gitlab -> platform.flux "PLANNED: reviewed Git promotion of approved artifact references" { #planned }
}
views {
  view index {
    title "The whole platform"
    description "A map of the reference design, from shared foundations to tenant workloads."
    include platform, tenant, portal, external, gitlab, harbor
    autoLayout LeftRight
  }
  view foundation of platform {
    title "Inside the foundation"
    description "Big Bang supplies packages. Flux reconciles applications. Rancher stays with platform engineering."
    include platform.rke2, platform.flux, platform.bigbang, platform.rancher, platform.keycloak, platform.headlamp, platform.openbao
    autoLayout LeftRight
  }
  view identity {
    title "Identity is a starting point"
    description "Keycloak supplies identity. Each application and Kubernetes enforce their own authorization decisions."
    include portal, platform.keycloak, platform.headlamp, tenant.workload, tenant.data
    autoLayout LeftRight
  }
  view platformBoundary {
    title "Platform authorization scope"
    description "Proposed shared-platform assessment scope and dependencies. Scope remains subject to authorizing-official review."
    include platform.rke2, platform.flux, platform.bigbang, platform.rancher, platform.keycloak, platform.headlamp, platform.openbao, portal, tenant, external, gitlab, harbor
    autoLayout LeftRight
  }
  view tenantBoundary of tenant {
    title "Inside a tenant boundary"
    description "A generic tenant scope with shared services outside it. A box does not enforce isolation."
    include tenant.workload, tenant.data, platform.headlamp, platform.keycloak, platform.flux
    autoLayout LeftRight
  }
  view intake {
    title "From external image to workload"
    description "External image → GitLab validation / Trivy → Harbor → Flux desired-state review → workloads. Flux carries references, while the runtime pulls bytes from Harbor."
    include external, gitlab, harbor, platform.flux, tenant.workload
    autoLayout LeftRight
  }
  dynamic view intakeWalkthrough {
    title "Bring in an external image · planned"
    external -> gitlab "PLANNED: Validate and scan"
    gitlab -> harbor "PLANNED: Publish exact content"
    harbor -> platform.flux "PLANNED: Review desired state"
    platform.flux -> tenant.workload "PLANNED: Run and verify"
  }
  dynamic view identityWalkthrough {
    title "Follow a sign-in · current"
    portal -> platform.keycloak "CURRENT: Verify identity and policy"
    platform.keycloak -> portal "CURRENT: Read scoped data"
  }
}
