  baoIdentity -> esoIdentity "CURRENT: Exact path policy" { #current }
  esoIdentity -> serviceCredentials "CURRENT: Owned Kubernetes Secret delivery" { #current }
  runtimeIdentity -> baoIdentity "CURRENT: Kubernetes machine authentication" { #current }
  runtimeIdentity -> appAuth "CURRENT: API identity subject to resource policy" { #current }
