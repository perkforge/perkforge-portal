views {
  view identityLifecycle {
    title "Identity: install to tenant"
    description "First review document: the complete identity lifecycle, from node installation to tenant workloads. Current means source-backed, not a live security certification."
    include custody, installer, nodeIdentity, pki, bootstrap, gitops, appInstaller, human, platformAuthority, appAuth, tenantAuthority, baoIdentity, esoIdentity, runtimeIdentity, serviceCredentials, recovery, cloudTrust, rds
    autoLayout LeftRight
  }
  view bootstrapIdentity {
    title "Bootstrap & installer trust"
    description "How node, platform and application installers hand authority forward. Bootstrap and recovery power are not runtime identities."
    include custody, installer, nodeIdentity, pki, bootstrap, gitops, appInstaller, recovery
    autoLayout LeftRight
  }
  view humanIdentity {
    title "People & application access"
    description "Authentication, platform authority and tenant scope are separate. Each app must enforce its native access model."
    include human, platformAuthority, tenantAuthority, appAuth, pki
    autoLayout LeftRight
  }
  view workloadIdentity {
    title "Secrets & workload identity"
    description "Dedicated workload and secret-delivery identities today; external cloud and RDS identity is explicitly planned."
    include gitops, appInstaller, runtimeIdentity, baoIdentity, esoIdentity, serviceCredentials, cloudTrust, rds
    autoLayout LeftRight
  }
  view activeIdentity {
    title "Current identity observations"
    description "A reviewed operational snapshot, not automatic discovery. Consult the dated evidence and distinguish active, staged and source-only identities."
    include platformAuthority, baoIdentity, esoIdentity, deploymentPublisher, incidentPublisher, mattermostOperator, portalInventory, runtimeIdentity, cloudTrust
    autoLayout LeftRight
  }
  view index {
    title "The whole platform"
    description "A map of the reference design, from shared foundations to tenant workloads."
    include platform, tenant, portal, external, gitlab, harbor
    autoLayout LeftRight
  }
  view foundation of platform {
    title "Inside the foundation"
    description "Big Bang supplies packages. Flux reconciles applications. Rancher stays with platform engineering."
    include platform.rke2, platform.flux, platform.bigbang, platform.rancher, platform.keycloak, platform.headlamp, platform.openbao
    autoLayout LeftRight
  }
  view identity {
    title "Identity is a starting point"
    description "Keycloak supplies identity. Each application and Kubernetes enforce their own authorization decisions."
    include portal, platform.keycloak, platform.headlamp, tenant.workload, tenant.data
    autoLayout LeftRight
  }
  view platformBoundary {
    title "Platform authorization scope"
    description "Proposed shared-platform assessment scope and dependencies. Scope remains subject to authorizing-official review."
    include platform.rke2, platform.flux, platform.bigbang, platform.rancher, platform.keycloak, platform.headlamp, platform.openbao, portal, tenant, external, gitlab, harbor
    autoLayout LeftRight
  }
  view tenantBoundary of tenant {
    title "Inside a tenant boundary"
    description "A generic tenant scope with shared services outside it. A box does not enforce isolation."
    include tenant.workload, tenant.data, platform.headlamp, platform.keycloak, platform.flux
    autoLayout LeftRight
  }
  view intake {
    title "From external image to workload"
    description "External image → GitLab validation / Trivy → Harbor → Flux desired-state review → workloads. Flux carries references, while the runtime pulls bytes from Harbor."
    include external, gitlab, harbor, platform.flux, tenant.workload
    autoLayout LeftRight
  }
  dynamic view identityLifecycleWalkthrough {
    title "From install to tenant workload · unverified"
    installer -> bootstrap "UNVERIFIED: Bootstrap the platform"
    bootstrap -> gitops "UNVERIFIED: Delegate reconciliation"
    gitops -> human "UNVERIFIED: Authenticate people"
    human -> runtimeIdentity "UNVERIFIED: Identify each workload"
    runtimeIdentity -> baoIdentity "UNVERIFIED: Authenticate to the secret authority"
    baoIdentity -> esoIdentity "UNVERIFIED: Deliver owned secrets"
    esoIdentity -> cloudTrust "UNVERIFIED: Extend trust deliberately"
  }
  dynamic view intakeWalkthrough {
    title "Bring in an external image · planned"
    external -> gitlab "PLANNED: Validate and scan"
    gitlab -> harbor "PLANNED: Publish exact content"
    harbor -> platform.flux "PLANNED: Review desired state"
    platform.flux -> tenant.workload "PLANNED: Run and verify"
  }
  dynamic view identityWalkthrough {
    title "Follow a sign-in · current"
    portal -> platform.keycloak "CURRENT: Verify identity and policy"
    platform.keycloak -> portal "CURRENT: Read scoped data"
  }
}
