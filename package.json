{
  "name": "perkforge-portal",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "npm run architecture:generate && tsc --noEmit && vite build",
    "typecheck": "npm run architecture:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm test",
    "architecture:source": "node scripts/architecture-model.mjs",
    "architecture:validate": "node scripts/architecture-model.mjs --check && likec4 validate architecture/public",
    "architecture:generate": "npm run architecture:validate && likec4 codegen react architecture/public -o src/architecture/likec4.generated.js",
    "architecture:standalone": "npm run architecture:validate && likec4 build architecture/public -o dist-architecture --use-hash-history --theme dark --title \"PerkForge Platform Explorer\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "likec4": "1.60.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
